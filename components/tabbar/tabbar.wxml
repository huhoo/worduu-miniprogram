<view class="tabbar">
  <view
    wx:for="{{tabs}}"
    wx:key="key"
    class="tabbar-item {{current === item.key ? 'active' : ''}}"
    data-key="{{item.key}}"
    bindtap="onTap"
  >
    <image class="tabbar-icon" src="{{current === item.key ? item.iconActive : item.icon}}" mode="aspectFit" />
    <view class="tabbar-label">{{item.label}}</view>
  </view>
</view>
