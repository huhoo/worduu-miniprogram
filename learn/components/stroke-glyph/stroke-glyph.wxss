.glyph {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.stage {
  position: relative;
  border-radius: 28rpx;
  overflow: hidden;
}

.stage-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tianzige {
  background: #FFFFFF;
  border: 4rpx solid #6DB589;
}

.glyph-canvas {
  display: block;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FAFAF9;
  border: 1rpx solid #DCE8D9;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 6rpx solid #E9F4E5;
  border-top-color: #3F8E5D;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.ghost {
  color: #D6D3D1;
}

.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.empty-note {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #78716C;
  text-align: center;
  padding: 0 24rpx;
}

.badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  background: #E9F4E5;
  color: #2F6B50;
  font-size: 22rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid #C0D3BD;
}

.dots {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  margin-top: 20rpx;
}

.dot {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #F5F5F4;
  color: #93A397;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 6rpx;
}

.dot-done {
  background: #DCE8D9;
  color: #57685B;
}

.dot-current {
  background: #3F8E5D;
  color: #FFFFFF;
  box-shadow: 0 0 0 6rpx #BFE3C9;
}

/* ---------- 笔画名 ---------- */
.pills {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  margin-top: 12rpx;
  padding: 0 12rpx;
}

.pill {
  background: #F6EEDD;
  border: 1rpx solid #E9D8AC;
  color: #8C6D1F;
  font-size: 24rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  margin: 6rpx;
  min-height: 88rpx;
}

.pill-current {
  background: #B8862E;
  border-color: #B8862E;
  color: #FFFFFF;
  font-weight: 700;
}

.stroke-name {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #57685B;
  text-align: center;
}

.controls {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
}

.ctrl {
  width: 88rpx;
  height: 88rpx;
  border-radius: 18rpx;
  border: 1rpx solid #DCE8D9;
  background: #FFFFFF;
  color: #57685B;
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ctrl-off {
  opacity: 0.3;
}

.play {
  margin: 0 24rpx;
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  background: #3F8E5D;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  min-height: 88rpx;
}

.play:active {
  opacity: 0.8;
}

.credit {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #D6D3D1;
  text-align: center;
}
