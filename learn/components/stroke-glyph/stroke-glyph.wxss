.glyph {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.stage {
  position: relative;
  border-radius: 28rpx;
  overflow: hidden;
}

.stage-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tianzige {
  background: #FFFFFF;
  border: 4rpx solid #6DB589;
}

.glyph-canvas {
  display: block;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--app-bg);
  border: 1rpx solid var(--line);
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 6rpx solid #E9F4E5;
  border-top-color: #3F8E5D;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* 无数据时的字形底：与有数据时的浅绿字印一致（BASELINE：字卡字印浅绿 #BFE3C9） */
.ghost {
  color: #BFE3C9;
}

.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.empty-note {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--ink-2);
  text-align: center;
  padding: 0 24rpx;
}

.badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  background: var(--green-light);
  color: var(--indigo);
  font-size: 22rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line-2);
}

.dots {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  margin-top: 20rpx;
}

.dot {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--app-surface-2);
  color: var(--ink-3);
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 6rpx;
}

.dot-done {
  background: #DCE8D9;
  color: #57685B;
}

.dot-current {
  background: #3F8E5D;
  color: #FFFFFF;
  box-shadow: 0 0 0 6rpx #BFE3C9;
}

/* ---------- 笔画名 ---------- */
.pills {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  margin-top: 12rpx;
  padding: 0 12rpx;
}

.pill {
  background: var(--amber-light);
  border: 1rpx solid var(--amber-line);
  color: var(--amber-ink);
  font-size: 24rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  margin: 6rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pill-current {
  background: var(--amber);
  border-color: var(--amber);
  color: #FFFFFF;
  font-weight: 700;
}

.stroke-name {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #57685B;
  text-align: center;
}

.controls {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
}

.ctrl {
  width: 88rpx;
  height: 88rpx;
  border-radius: 18rpx;
  border: 1rpx solid #DCE8D9;
  background: #FFFFFF;
  color: #57685B;
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ctrl-off {
  opacity: 0.3;
}

.play {
  margin: 0 24rpx;
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  background: #3F8E5D;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  min-height: 88rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.play:active {
  opacity: 0.8;
}

.credit {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  text-align: center;
}
