/* ---------- 月历 ---------- */
.cal-h {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cal-nav {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--app-surface-2);
  color: var(--ink-2);
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cal-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}

.cal-tools {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.legend {
  display: flex;
}

.lg {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  color: var(--ink-3);
  margin-right: 20rpx;
}

.lg-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--green);
  margin-right: 8rpx;
}

.lg-today {
  width: 16rpx;
  height: 16rpx;
  border: 2rpx dashed var(--ink-3);
  border-radius: 6rpx;
  margin-right: 8rpx;
}

.range-toggle {
  font-size: 22rpx;
  color: var(--indigo);
  background: var(--green-light);
  border: 1rpx solid var(--line-2);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}

.range-toggle.on {
  background: var(--green);
  color: #FFFFFF;
  border-color: var(--green);
}

.cal-grid {
  display: flex;
  margin-top: 16rpx;
}

.cw {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-3);
  padding: 8rpx 0;
}

.cal-week {
  display: flex;
}

.d-wrap {
  flex: 1;
}

.d {
  height: 84rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  border-radius: 16rpx;
}

.d.blank {
  visibility: hidden;
}

.d-num {
  font-size: 26rpx;
  color: var(--ink);
}

/* 有新增：数字下一个墨点 */
.d-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--green);
  margin-top: 4rpx;
}

/* 今天：虚线框 */
.d.today {
  outline: 2rpx dashed var(--ink-3);
  outline-offset: -4rpx;
}

/* 选中日：实心绿圆 */
.d.sel {
  background: var(--green);
}

.d.sel .d-num {
  color: #FFFFFF;
  font-weight: 700;
}

.d.sel .d-dot {
  background: #FFFFFF;
}

/* 选范围：起点/终点实心辅绿，区间内浅绿底 */
.d.rs,
.d.re {
  background: var(--green-2);
}

.d.rs .d-num,
.d.re .d-num {
  color: #FFFFFF;
  font-weight: 700;
}

.d.rm {
  background: var(--green-light);
}

/* ---------- 日详情 ---------- */
.day-card .row-t {
  color: var(--indigo);
}

.day-acts {
  display: flex;
  margin-top: 24rpx;
}

.day-acts .btn {
  flex: 1;
}

.day-acts .btn + .btn {
  margin-left: 20rpx;
}

.fc-words {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.fw {
  min-width: 72rpx;
  min-height: 88rpx;
  margin: 8rpx;
  border-radius: 16rpx;
  background: var(--app-surface-2);
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--ink);
}

/* ---------- 区间条 ---------- */
.range-line {
  display: flex;
  align-items: center;
}

.rg {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
}

.rg-line {
  flex: 1;
  height: 2rpx;
  background: var(--line-2);
  margin: 0 16rpx;
}

.rg-n {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--green);
}

/* ---------- 其它 ---------- */
.empty-fp {
  text-align: center;
  padding: 48rpx 28rpx;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.tipcard {
  margin-top: 24rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--ink-3);
  padding: 0 12rpx;
}
