<!-- 写字识字 = 手写查字闭环（2026-10-29 重构：删字条/页签/练写） -->
<view class="page" wx:if="{{stage === 'write'}}">
  <view class="card">
    <text class="sub">遇到不会读的字？在田字格里写出来，AI 帮你认。</text>
    <view class="canvas-wrap">
      <view class="tianzige" style="width:300px;height:300px">
        <canvas
          type="2d"
          id="write-canvas"
          class="write-canvas"
          style="width:300px;height:300px"
          disable-scroll="{{true}}"
          bindtouchstart="onTouchStart"
          bindtouchmove="onTouchMove"
          bindtouchend="onTouchEnd"
          bindtouchcancel="onTouchEnd"
        ></canvas>
      </view>
      <view class="stroke-badge">已写 {{strokeCount}} 笔</view>
    </view>

    <view class="row tools">
      <view class="btn btn-ghost tool-btn" bindtap="undo">撤销一笔</view>
      <view class="btn btn-ghost tool-btn" bindtap="clearBoard">重写清除</view>
    </view>

    <view wx:if="{{note}}" class="notice">
      <text class="notice-text">{{note}}</text>
    </view>

    <view class="btn btn-primary submit-btn {{strokeCount === 0 || recognizing ? 'btn-disabled' : ''}}" bindtap="recognize">
      {{recognizing ? 'AI 正在认字…' : 'AI 帮我识字'}}
    </view>
  </view>

  <!-- 候选：点某个字进详情下页 -->
  <view class="card" wx:if="{{candidates.length}}">
    <text class="result-title">你写的是这个字吗？点一下查看</text>
    <view class="cand-list">
      <view
        class="cand"
        wx:for="{{candidates}}"
        wx:key="char"
        wx:for-item="cand"
        data-char="{{cand.char}}"
        bindtap="chooseCandidate"
      >
        <text class="cand-char kai">{{cand.char}}</text>
        <view class="cand-info">
          <view class="row">
            <text class="cand-pinyin">{{cand.pinyin}}</text>
            <text class="cand-conf">{{cand.confidence}}%</text>
          </view>
          <text class="cand-meaning">{{cand.meaning}}</text>
          <text class="cand-words" wx:if="{{cand.wordsText}}">{{cand.wordsText}}</text>
        </view>
        <text class="cand-go">›</text>
      </view>
    </view>
    <view class="btn btn-ghost re-btn" bindtap="clearBoard">不是这些字，重新写</view>
  </view>
</view>

<!-- 下页：点选的汉字详情，字框旁小加号询问是否入库 -->
<view class="page" wx:else>
  <view class="card lookup-detail">
    <view class="detail-head">
      <view class="detail-char-box kai">{{chosen.char}}</view>
      <!-- 小加号：询问是否加入生字库 -->
      <view wx:if="{{!added}}" class="plus-btn" bindtap="addToLibrary">
        <image class="plus-img" src="/images/icons/plus-green.png" mode="aspectFit" />
      </view>
      <view wx:else class="plus-btn plus-done" bindtap="goDetail">
        <image class="plus-img" src="/images/icons/sprout-green.png" mode="aspectFit" />
      </view>
    </view>
    <view class="plus-hint">{{added ? '已在生字库里，点查看完整字卡' : '点 + 加入生字库'}}</view>

    <view class="detail-row">
      <text class="detail-pinyin">{{chosen.pinyin}}</text>
      <text class="cand-conf">{{chosen.confidence}}%</text>
      <view class="btn btn-ghost audio-mini" bindtap="playChosen">
        <image class="ic-inline" src="/images/icons/speaker-green.png" mode="aspectFit" /><text>听读音</text>
      </view>
    </view>

    <view class="detail-block">
      <text class="detail-label">释义</text>
      <text class="detail-text">{{chosen.meaning || '暂无释义'}}</text>
    </view>
    <view class="detail-block">
      <text class="detail-label">组词</text>
      <text class="detail-text">{{wordsText || '暂无组词'}}</text>
    </view>

    <view class="row detail-actions">
      <view class="btn btn-primary detail-btn" wx:if="{{added}}" bindtap="goDetail">查看完整字卡</view>
      <view class="btn {{added ? 'btn-ghost' : 'btn-primary'}} detail-btn" wx:else bindtap="addToLibrary">加入生字库</view>
      <view class="btn btn-ghost detail-btn" bindtap="backToCandidates">不是这个字</view>
    </view>
  </view>
</view>

<tabbar current="write" />
