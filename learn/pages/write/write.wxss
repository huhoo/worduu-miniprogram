/* ---------- 字头 ---------- */
.head-char {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--ink);
}

.head-meta {
  margin-left: 20rpx;
  font-size: 22rpx;
  color: #57685B;
}

.tabs {
  margin-top: 24rpx;
  background: #ECF4E9;
  border-radius: 20rpx;
  padding: 6rpx;
}

.tab {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #57685B;
  min-height: 88rpx;
}

.tab-on {
  background: #FFFFFF;
  color: var(--indigo);
  box-shadow: 0 1rpx 3rpx rgba(43, 58, 48, 0.06);
}

/* ---------- 模式 ---------- */
.mode-row {
  margin-bottom: 24rpx;
}

.mode-switch {
  background: #ECF4E9;
  border-radius: 14rpx;
  padding: 4rpx;
}

.mode {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 24rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: var(--ink-2);
  min-height: 88rpx;
}

.mode-on {
  background: var(--green);
  color: #FFFFFF;
  font-weight: 700;
}

/* ---------- 画布 ---------- */
.canvas-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.write-canvas {
  display: block;
}

.stroke-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: rgba(255, 251, 235, 0.92);
  color: var(--amber-ink);
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--amber-line);
}

/* ---------- 工具 ---------- */
.tools {
  margin-top: 24rpx;
}

.tool-btn {
  flex: 1;
  padding: 18rpx 0;
  font-size: 22rpx;
  min-height: 88rpx;
}

.tools .tool-btn + .tool-btn {
  margin-left: 16rpx;
  min-height: 88rpx;
}

.count-row {
  margin-top: 24rpx;
  justify-content: center;
}

.count-num {
  font-weight: 800;
  font-family: 'SF Mono', Menlo, monospace;
  color: var(--ink);
}

.count-num.green {
  color: var(--green);
}

.submit-btn {
  margin-top: 24rpx;
  width: 100%;
  min-height: 88rpx;
}

/* ---------- 结果 ---------- */
.result {
  margin-top: 28rpx;
  background: #F5FAF3;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 24rpx;
}

.result-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--ink);
}

.result-score {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--green);
  font-family: 'SF Mono', Menlo, monospace;
}

.result-feedback {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.7;
}

.improve {
  margin-top: 16rpx;
  background: var(--amber-light);
  border: 1rpx solid var(--amber-line);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 22rpx;
  color: var(--amber-ink);
  line-height: 1.6;
}

.next-btn {
  margin-top: 20rpx;
  width: 100%;
  min-height: 88rpx;
}

.notice {
  margin-top: 24rpx;
  background: #FFF1F2;
  border: 1rpx solid #FECDD3;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}

.notice-text {
  font-size: 24rpx;
  color: #9F1239;
  line-height: 1.6;
}

.animate-btn {
  margin-top: 32rpx;
  width: 100%;
  min-height: 88rpx;
}

.empty-btn {
  margin: 28rpx auto 0;
  width: 60%;
  min-height: 88rpx;
}

.empty-btn + .empty-btn {
  margin-top: 20rpx;
}

/* ---------- 手写查字 ---------- */
.lookup-wrap {
  margin-top: 20rpx;
}

.cand-list {
  margin-top: 16rpx;
}

.cand {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-top: 16rpx;
}

.cand-on {
  border-color: var(--green);
  background: #F5FAF3;
}

.cand-char {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--ink);
  width: 96rpx;
  text-align: center;
  flex-shrink: 0;
}

.cand-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.cand-pinyin {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--indigo);
  font-family: 'SF Mono', Menlo, monospace;
}

.cand-conf {
  margin-left: 14rpx;
  font-size: 20rpx;
  color: #57685B;
  font-family: 'SF Mono', Menlo, monospace;
}

.cand-meaning {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-2);
  line-height: 1.6;
}

.cand-words {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--green);
}

.confirm-row {
  margin-top: 20rpx;
}

.confirm-text {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--ink);
}

.confirm-btn {
  flex: 1;
  margin-top: 16rpx;
  min-height: 88rpx;
}

.confirm-btn + .confirm-btn {
  margin-left: 16rpx;
}

/* ---------- 2026-10-29 重构：候选直达 + 详情下页 ---------- */
.cand-go {
  font-size: 44rpx;
  color: #9DB4A3;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.re-btn {
  margin-top: 24rpx;
  width: 100%;
  min-height: 88rpx;
}

.lookup-detail {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.detail-head {
  position: relative;
  display: flex;
  align-items: flex-start;
}

.detail-char-box {
  width: 240rpx;
  height: 240rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 140rpx;
  font-weight: 800;
  color: var(--ink);
  background: #FFFFFF;
  border: 2rpx solid #C0D3BD;
  border-radius: 28rpx;
}

.plus-btn {
  width: 72rpx;
  height: 72rpx;
  margin: -10rpx 0 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--green-light);
  border: 2rpx solid var(--green);
  border-radius: 50%;
  flex-shrink: 0;
}

.plus-btn.plus-done {
  background: #DCFCE7;
  border-color: #86EFAC;
}

.plus-img {
  width: 40rpx;
  height: 40rpx;
}

.plus-hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #57685B;
}

.detail-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  width: 100%;
}

.detail-pinyin {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--indigo);
  font-family: 'SF Mono', Menlo, monospace;
}

.audio-mini {
  display: flex;
  align-items: center;
  margin-left: 20rpx;
  font-size: 22rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  min-height: 88rpx;
}

.detail-block {
  width: 100%;
  margin-top: 26rpx;
  background: #F5FAF3;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  text-align: left;
}

.detail-label {
  display: block;
  font-size: 22rpx;
  color: #57685B;
}

.detail-text {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--ink);
  line-height: 1.7;
}

.detail-actions {
  margin-top: 30rpx;
  width: 100%;
}

.detail-btn {
  flex: 1;
  min-height: 88rpx;
}

.detail-btn + .detail-btn {
  margin-left: 16rpx;
}
