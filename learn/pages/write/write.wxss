/* ---------- 字头 ---------- */
.head-char {
  font-size: 56rpx;
  font-weight: 800;
  color: #1C1917;
}

.head-meta {
  margin-left: 20rpx;
  font-size: 22rpx;
  color: #78716C;
}

.tabs {
  margin-top: 24rpx;
  background: #F5F5F4;
  border-radius: 20rpx;
  padding: 6rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #78716C;
  min-height: 88rpx;
}

.tab-on {
  background: #FFFFFF;
  color: #065F46;
  box-shadow: 0 1rpx 3rpx rgba(28, 25, 23, 0.06);
}

/* ---------- 模式 ---------- */
.mode-row {
  margin-bottom: 24rpx;
}

.mode-switch {
  background: #F5F5F4;
  border-radius: 14rpx;
  padding: 4rpx;
}

.mode {
  padding: 10rpx 24rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #57534E;
  min-height: 88rpx;
}

.mode-on {
  background: #059669;
  color: #FFFFFF;
  font-weight: 700;
}

/* ---------- 画布 ---------- */
.canvas-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.write-canvas {
  display: block;
}

.stroke-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: rgba(255, 251, 235, 0.92);
  color: #92400E;
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid #FDE68A;
}

/* ---------- 工具 ---------- */
.tools {
  margin-top: 24rpx;
}

.tool-btn {
  flex: 1;
  padding: 18rpx 0;
  font-size: 22rpx;
  min-height: 88rpx;
}

.tools .tool-btn + .tool-btn {
  margin-left: 16rpx;
  min-height: 88rpx;
}

.count-row {
  margin-top: 24rpx;
  justify-content: center;
}

.count-num {
  font-weight: 800;
  font-family: 'SF Mono', Menlo, monospace;
  color: #1C1917;
}

.count-num.green {
  color: #059669;
}

.submit-btn {
  margin-top: 24rpx;
  width: 100%;
  min-height: 88rpx;
}

/* ---------- 结果 ---------- */
.result {
  margin-top: 28rpx;
  background: #FAFAF9;
  border: 1rpx solid #E7E5E4;
  border-radius: 24rpx;
  padding: 24rpx;
}

.result-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #1C1917;
}

.result-score {
  font-size: 22rpx;
  font-weight: 700;
  color: #059669;
  font-family: 'SF Mono', Menlo, monospace;
}

.result-feedback {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #57534E;
  line-height: 1.7;
}

.improve {
  margin-top: 16rpx;
  background: #FFFBEB;
  border: 1rpx solid #FDE68A;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 22rpx;
  color: #92400E;
  line-height: 1.6;
}

.next-btn {
  margin-top: 20rpx;
  width: 100%;
  min-height: 88rpx;
}

.notice {
  margin-top: 24rpx;
  background: #FFF1F2;
  border: 1rpx solid #FECDD3;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}

.notice-text {
  font-size: 24rpx;
  color: #9F1239;
  line-height: 1.6;
}

.animate-btn {
  margin-top: 32rpx;
  width: 100%;
  min-height: 88rpx;
}

.empty-btn {
  margin: 28rpx auto 0;
  width: 60%;
  min-height: 88rpx;
}
