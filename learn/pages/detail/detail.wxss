/* ---------- 字头 ---------- */
.head {
  display: flex;
  align-items: center;
}

.head-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 200rpx;
  flex-shrink: 0;
}

.big-char {
  width: 176rpx;
  height: 176rpx;
  border-radius: 28rpx;
  background: var(--app-surface);
  border: 4rpx solid var(--vermilion);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 108rpx;
  font-weight: 800;
  color: var(--ink);
}

.big-pinyin {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  font-family: 'SF Mono', Menlo, monospace;
  color: var(--indigo);
}

.head-right {
  flex: 1;
  margin-left: 28rpx;
}

.meta-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #DCE8D9;
}

.meta-row:last-child {
  border-bottom: none;
}

.meta-label {
  width: 80rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.meta-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
}

/* ---------- 发音 ---------- */
.audio-row {
  margin-top: 24rpx;
}

.audio-btn {
  flex: 1;
  min-height: 88rpx;
}

.audio-row .audio-btn:first-child {
  margin-right: 16rpx;
}

/* ---------- 笔顺 ---------- */
.glyph-wrap {
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
}

/* ---------- 正文块 ---------- */
.body-text {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.75;
}

.words {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
}

.word {
  background: var(--green-light);
  color: var(--indigo);
  border: 1rpx solid var(--line-2);
  border-radius: 16rpx;
  padding: 10rpx 24rpx;
  font-size: 26rpx;
  margin: 0 16rpx 16rpx 0;
}

/* ---------- 状态 ---------- */
.loading-tip {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid var(--green-light);
  border-top-color: var(--green);
  border-radius: 50%;
  margin-right: 14rpx;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.notice {
  margin-top: 24rpx;
  background: var(--amber-light);
  border: 1rpx solid var(--amber-line);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}

.notice-text {
  font-size: 24rpx;
  color: var(--amber-ink);
  line-height: 1.6;
}

.write-btn {
  margin-top: 32rpx;
  width: 100%;
  min-height: 88rpx;
}

/* ---------- 字源「记一记」：AI 生成内容必须带出处标注 ---------- */
.origin {
  background: #EFF6FF;
  border-color: #BFDBFE;
}

.origin-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E40AF;
}

.origin-tag {
  font-size: 22rpx;
  color: #1E40AF;
  opacity: 0.8;
}

.origin-note {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  line-height: 1.7;
}
