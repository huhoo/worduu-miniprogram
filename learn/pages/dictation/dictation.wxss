/* ---------- 顶部进度条 ---------- */
.bar {
  background: #FFFFFF;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 18rpx 28rpx;
}

.bar-emoji {
  font-size: 30rpx;
  margin-right: 10rpx;
}

.bar-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink-2);
}

.bar-progress {
  font-size: 24rpx;
  font-weight: 700;
  font-family: 'SF Mono', Menlo, monospace;
  color: var(--indigo);
  background: var(--green-light);
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
}

/* ---------- 发音卡 ---------- */
.listen {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.play-btn {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--green-light);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 0 12rpx #F0FDF4;
  transition: transform 0.15s, background 0.15s;
  min-height: 88rpx;
}

.play-btn.playing {
  background: var(--green);
  transform: scale(1.06);
}

.play-icon {
  font-size: 56rpx;
  line-height: 1;
}

.listen-title {
  margin-top: 20rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--ink);
}

.listen-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.audio-row {
  margin-top: 20rpx;
}

.audio-btn {
  font-size: 22rpx;
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  min-height: 88rpx;
}

.audio-row .audio-btn + .audio-btn {
  margin-left: 16rpx;
  min-height: 88rpx;
}

.audio-btn.amber {
  background: var(--amber-light);
  border-color: var(--amber-line);
  color: var(--amber-ink);
}

/* ---------- 书写区 ---------- */
.write-card {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.canvas-wrap {
  display: flex;
  justify-content: center;
}

.canvas {
  display: block;
}

.tools {
  margin-top: 20rpx;
  justify-content: center;
}

.tool {
  font-size: 22rpx;
  color: var(--ink-2);
  background: #ECF4E9;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  min-height: 88rpx;
}

.tools .tool + .tool {
  margin-left: 16rpx;
  min-height: 88rpx;
}

.stroke-count {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--ink-3);
  font-family: 'SF Mono', Menlo, monospace;
}

/* ---------- 批改结果 ---------- */
.verdict {
  margin-top: 24rpx;
  width: 100%;
  background: #F5FAF3;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 24rpx;
  text-align: center;
}

.verdict-note {
  display: block;
  text-align: left;
  font-size: 22rpx;
  color: #9F1239;
  background: #FFF1F2;
  border: 1rpx solid #FECDD3;
  border-radius: 16rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 18rpx;
  line-height: 1.6;
}

.row-center {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.verdict-char {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--ink);
}

.verdict-pinyin {
  margin-left: 14rpx;
  font-size: 22rpx;
  font-family: 'SF Mono', Menlo, monospace;
  color: var(--indigo);
}

.tag {
  margin-left: 14rpx;
  font-size: 24rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.tag-ok {
  background: #DCFCE7;
  color: #166534;
}

.tag-bad {
  background: #FEE2E2;
  color: #991B1B;
}

.verdict-strokes {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--ink-2);
}

.verdict-feedback {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.7;
  text-align: left;
}

.submit-btn {
  margin-top: 24rpx;
  width: 100%;
  min-height: 88rpx;
}

/* ---------- 报告 ---------- */
.report {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.report-emoji {
  font-size: 72rpx;
  line-height: 1.2;
}

.report-title {
  margin-top: 12rpx;
  font-size: 36rpx;
  font-weight: 800;
  color: var(--ink);
}

.report-score {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-2);
}

.progress {
  margin-top: 24rpx;
  width: 100%;
  height: 16rpx;
  background: #ECF4E9;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--green);
  border-radius: 999rpx;
  transition: width 0.3s;
}

.report-percent {
  margin-top: 10rpx;
  font-size: 22rpx;
  font-weight: 700;
  font-family: 'SF Mono', Menlo, monospace;
  color: var(--green);
}

.report-wrong {
  margin-top: 32rpx;
  width: 100%;
}

.report-wrong-title {
  display: block;
  font-size: 22rpx;
  color: #57685B;
  text-align: left;
}

.wrong-row {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
}

.wrong-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #FFF1F2;
  border-radius: 20rpx;
  padding: 16rpx 0;
  margin-top: 12rpx;
  min-height: 88rpx;
}

.wrong-char {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--ink);
}

.wrong-pinyin {
  font-size: 24rpx;
  color: #9F1239;
}

.wrong-strokes {
  font-size: 22rpx;
  color: var(--ink-3);
}

.report-note {
  margin-top: 28rpx;
  font-size: 24rpx;
  color: var(--ink-2);
}

/* ---------- 空字库 ---------- */
.center {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding-top: 120rpx;
}

.empty-emoji {
  font-size: 80rpx;
  opacity: 0.4;
}

.empty-title {
  margin-top: 24rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #2B3A30;
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #57685B;
  line-height: 1.7;
  max-width: 520rpx;
}

.empty-btn {
  margin-top: 32rpx;
  width: 60%;
  min-height: 88rpx;
}

.mt {
  margin-top: 24rpx;
}
