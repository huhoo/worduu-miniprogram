/* ---------- 顶部进度条 ---------- */
.bar {
  background: #FFFFFF;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 18rpx 28rpx;
}

.bar-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
}

.bar-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink-2);
}

.bar-progress {
  font-size: 24rpx;
  font-weight: 700;
  font-family: 'SF Mono', Menlo, monospace;
  color: var(--indigo);
  background: var(--green-light);
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
}

/* ---------- 进行中：写字框居中 ---------- */
.write-stage {
  display: flex;
  flex-direction: column;
}

/* 顶栏：标题 + 进度 + 重听，三个占一行 */
.bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 18rpx 28rpx;
}

.bar-replay {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--green-light);
}

.bar-replay.playing {
  background: var(--green);
}

.bar-replay-img {
  width: 34rpx;
  height: 34rpx;
}

.stage-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
}

.char-hint {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--indigo);
  font-weight: 700;
}

.canvas-wrap {
  display: flex;
  justify-content: center;
}

.canvas {
  display: block;
}

.tools {
  margin-top: 20rpx;
  justify-content: center;
}

.tool {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--ink-2);
  background: #ECF4E9;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  min-height: 88rpx;
}

.tools .tool + .tool {
  margin-left: 16rpx;
  min-height: 88rpx;
}

.stroke-count {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--ink-3);
  font-family: 'SF Mono', Menlo, monospace;
}

/* ---------- 批改结果 ---------- */
.verdict {
  margin-top: 24rpx;
  width: 100%;
  background: #F5FAF3;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 24rpx;
  text-align: center;
}

.verdict-note {
  display: block;
  text-align: left;
  font-size: 22rpx;
  color: #9F1239;
  background: #FFF1F2;
  border: 1rpx solid #FECDD3;
  border-radius: 16rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 18rpx;
  line-height: 1.6;
}

.row-center {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.verdict-char,
.verdict-word {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--ink);
}

.verdict-pinyin {
  margin-left: 14rpx;
  font-size: 22rpx;
  font-family: 'SF Mono', Menlo, monospace;
  color: var(--indigo);
}

.tag {
  margin-left: 14rpx;
  font-size: 24rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.tag-ok {
  background: #DCFCE7;
  color: #166534;
}

.tag-bad {
  background: #FEE2E2;
  color: #991B1B;
}

.verdict-strokes {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--ink-2);
}

.verdict-feedback {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.7;
  text-align: left;
}

.submit-btn {
  margin-top: 24rpx;
  width: 100%;
  min-height: 88rpx;
}

/* ---------- 报告 ---------- */
.report {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.report-emoji {
  font-size: 72rpx;
  line-height: 1.2;
}

.report-title {
  margin-top: 12rpx;
  font-size: 36rpx;
  font-weight: 800;
  color: var(--ink);
}

.report-score {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-2);
}

.progress {
  margin-top: 24rpx;
  width: 100%;
  height: 16rpx;
  background: #ECF4E9;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--green);
  border-radius: 999rpx;
  transition: width 0.3s;
}

.report-percent {
  margin-top: 10rpx;
  font-size: 22rpx;
  font-weight: 700;
  font-family: 'SF Mono', Menlo, monospace;
  color: var(--green);
}

/* 报告：词语列表，错字标红 */
.report-words {
  margin-top: 32rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.rw {
  display: flex;
  align-items: baseline;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.rw-char {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--ink);
  margin: 0 2rpx;
}

.rw-char.rw-wrong {
  color: #DC2626;
}

.rw-pinyin {
  margin-left: 14rpx;
  font-size: 22rpx;
  font-family: 'SF Mono', Menlo, monospace;
  color: var(--indigo);
}

.rw-pinyin.rw-wrong-pinyin {
  color: #DC2626;
}

.report-note {
  margin-top: 28rpx;
  font-size: 24rpx;
  color: var(--ink-2);
}

/* ---------- 空字库 ---------- */
.center {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding-top: 120rpx;
}

/* ---------- 范围选择 ---------- */
.scope-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink);
}

.scope-card {
  display: flex;
  align-items: center;
  background: #F5FAF3;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 20rpx;
  min-height: 88rpx;
}

.scope-info {
  flex: 1;
  min-width: 0;
}

.scope-name-row {
  display: flex;
  align-items: center;
}

.scope-name {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
}

.scope-badge {
  margin-left: 12rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--amber-ink);
  background: var(--amber-light);
  border: 1rpx solid var(--amber-line);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
}

.scope-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #57685B;
  line-height: 1.6;
}

.scope-arrow {
  font-size: 40rpx;
  color: #9DB4A3;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.pick-done {
  min-height: 88rpx;
  padding: 0 28rpx;
  font-size: 24rpx;
}

.pick-grid {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
}

.pick-chip {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
  background: #F5FAF3;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  margin: 10rpx 10rpx 0 0;
}

.chip-on {
  border-color: var(--green);
  background: #DCFCE7;
  color: #166534;
}

.empty-emoji {
  font-size: 80rpx;
  opacity: 0.4;
}

/* 实心绿按钮里的浅色线条图标：白底圆片衬托绿线图标 */
.ic-inline-light {
  background: #FFFFFF;
  border-radius: 50%;
  padding: 6rpx;
  width: 34rpx;
  height: 34rpx;
}

.empty-title {
  margin-top: 24rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #2B3A30;
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #57685B;
  line-height: 1.7;
  max-width: 520rpx;
}

.empty-btn {
  margin-top: 32rpx;
  width: 60%;
  min-height: 88rpx;
}

.mt {
  margin-top: 24rpx;
}
