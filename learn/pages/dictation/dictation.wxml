<!-- 空字库：不出题，也不伪造一份卷子 -->
<view class="page center" wx:if="{{empty}}">
  <image class="ic-big" src="/images/icons/doc-green.png" mode="aspectFit" />
  <text class="empty-title">生字库还是空的，没有可以听写的字</text>
  <text class="empty-sub">先拍一页课本或课外书把生字收进来，听写会从这些字里出题。</text>
  <view class="btn btn-primary empty-btn" bindtap="goOcr">去拍照识字</view>
</view>

<!-- 范围选择：没有预设字带入时，先决定默哪批字（2026-10-30：人教版第一、自选第二） -->
<view class="page" wx:elif="{{scope}}">
  <view class="card">
    <view class="scope-title">选择默写范围</view>

    <view class="scope-card" bindtap="scopeTextbook">
      <view class="scope-info">
        <view class="scope-name-row">
          <image class="ic-inline" src="/images/icons/flag-green.png" mode="aspectFit" />
          <text class="scope-name">人教版教材生字库</text>
          <text class="scope-badge">建设中</text>
        </view>
        <view class="scope-desc">按年级、册、课组织的教材生字，即将上线</view>
      </view>
      <text class="scope-arrow">›</text>
    </view>

    <view class="scope-card" bindtap="scopePick">
      <view class="scope-info">
        <view class="scope-name-row">
          <image class="ic-inline" src="/images/icons/grid-green.png" mode="aspectFit" />
          <text class="scope-name">自选字</text>
        </view>
        <view class="scope-desc">从生字库里手动挑字组一卷（最多 20 字）</view>
      </view>
      <text class="scope-arrow">›</text>
    </view>
  </view>

  <!-- 自选挑字面板 -->
  <view class="card" wx:if="{{picking}}">
    <view class="row-between">
      <view class="scope-title">挑字组卷（{{pickedCount}}/20）</view>
      <view class="btn btn-primary pick-done {{pickedCount ? '' : 'btn-disabled'}}" bindtap="confirmPick">开始默写</view>
    </view>
    <view class="pick-grid" wx:if="{{picker.length}}">
      <view
        class="pick-chip {{item.picked ? 'chip-on' : ''}}"
        wx:for="{{picker}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="togglePick"
      >{{item.char}}</view>
    </view>
    <text class="scope-desc" wx:else>字库还是空的，先去拍照认字。</text>
  </view>
</view>

<!-- 听写报告 -->
<view class="page" wx:elif="{{done}}">
  <view class="card report">
    <text class="report-emoji">{{wrongCount === 0 ? '🎉' : '💪'}}</text>
    <text class="report-title">{{wrongCount === 0 ? '听写默写满分！' : '完成听写默写挑战！'}}</text>
    <text class="report-score">默对 {{correctWords}} / {{totalWords}} 词</text>

    <view class="progress">
      <view class="progress-fill" style="width: {{totalWords ? (correctWords / totalWords * 100) : 0}}%"></view>
    </view>
    <text class="report-percent">{{totalWords ? (correctWords / totalWords * 100) : 0}}%</text>

    <view class="report-words" wx:if="{{reportWords.length}}">
      <view class="rw" wx:for="{{reportWords}}" wx:key="word">
        <block wx:for="{{item.chars}}" wx:for-item="ch" wx:key="char">
          <text class="rw-char kai {{ch.wrong ? 'rw-wrong' : ''}}">{{ch.char}}</text>
        </block>
        <text class="rw-pinyin {{item.passed ? '' : 'rw-wrong-pinyin'}}">{{item.pinyin}}</text>
      </view>
    </view>

    <text class="report-note" wx:if="{{wrongCount === 0}}">全部默写正确，这些字已经记进「会写会默」清单。</text>
    <text class="report-note" wx:else>{{wrongCount}} 个字笔顺有误，已标红并归入待巩固库。</text>
  </view>

  <view class="btn btn-primary mt" wx:if="{{wrongCount > 0}}" bindtap="goReview">错字去待巩固库复习</view>
  <view class="btn btn-primary mt" bindtap="goAchievement">
    <image class="ic-inline ic-inline-light" src="/images/icons/trophy-green.png" mode="aspectFit" /><text>生成今日成就卡</text>
  </view>
  <view class="btn btn-primary mt" bindtap="restart">再听一轮</view>
  <view class="btn btn-ghost mt" bindtap="backHome">回到首页</view>
</view>

<!-- 听写进行中：写字框居中，顶部一行标题+进度+重听 -->
<view class="page write-stage" wx:else>
  <view class="bar">
    <view class="row">
      <image class="bar-icon" src="/images/icons/pencil-green.png" mode="aspectFit" />
      <text class="bar-title">听写默写测试</text>
      <text class="bar-progress">{{wordIndex + 1}} / {{totalWords}}</text>
    </view>
    <view class="bar-replay {{playing ? 'playing' : ''}}" bindtap="replay">
      <image class="bar-replay-img" src="/images/icons/speaker-green.png" mode="aspectFit" />
    </view>
  </view>

  <view class="stage-center">
    <view class="canvas-wrap">
      <canvas
        type="2d"
        id="dictation-canvas"
        class="canvas"
        style="width: 280px; height: 280px;"
        disable-scroll="{{true}}"
        bindtouchstart="onTouchStart"
        bindtouchmove="onTouchMove"
        bindtouchend="onTouchEnd"
      ></canvas>
    </view>

    <view class="char-hint" wx:if="{{withinWord && !revealed}}">
      第 {{charIndex + 1}} / {{wordCharCount}} 字：写出「{{currentChar}}」
    </view>

    <view class="row tools">
      <view class="tool" bindtap="undo">撤销一笔</view>
      <view class="tool" bindtap="clear">重写</view>
      <text class="stroke-count">已写 {{writtenStrokes}} 笔</text>
    </view>

    <!-- 整词批改结果 -->
    <view class="verdict" wx:if="{{revealed}}">
      <view class="row-center">
        <text class="verdict-word kai">{{currentWord.word}}</text>
        <text class="tag {{isCorrect ? 'tag-ok' : 'tag-bad'}}">{{isCorrect ? '默写正确' : '需复习巩固'}}</text>
      </view>
      <text class="verdict-note" wx:if="{{verdictNote}}">{{verdictNote}}</text>
    </view>

    <view class="btn btn-primary submit-btn" wx:if="{{!revealed}}" bindtap="submit">
      {{evaluating ? '正在核对笔顺…' : '提交'}}
    </view>
    <view class="btn btn-primary submit-btn" wx:else bindtap="next">
      {{isLastWord ? '查看听写报告' : '下一个'}}
    </view>
  </view>
</view>

<!-- 底栏四项之一：高亮「默写」 -->
<tabbar current="dictation" />
