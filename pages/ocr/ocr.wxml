<view class="page">
  <!-- 第一步：选来源、拍照 -->
  <block wx:if="{{step === 'pick'}}">
    <view class="card">
      <view class="row-between">
        <text class="title">这一页来自哪里？</text>
        <picker
          mode="selector"
          range="{{sources}}"
          value="{{sourceIndex}}"
          bindchange="onSourceChange"
        >
          <view class="picker">
            <text>{{sources[sourceIndex]}}</text>
            <text class="picker-arrow">▾</text>
          </view>
        </picker>
      </view>
      <text class="muted picker-note">来源会记进每个字的档案，方便日后回看孩子是在哪儿遇到它的。</text>
    </view>

    <view class="card">
      <view class="shoot" bindtap="chooseImage">
        <image wx:if="{{imagePath}}" src="{{imagePath}}" mode="widthFix" class="preview" />
        <view wx:else class="shoot-empty">
          <text class="shoot-emoji">📸</text>
          <text class="shoot-title">拍一页课本或课外书</text>
          <text class="muted">尽量正对纸面、光线均匀，识别更准</text>
        </view>
      </view>

      <view wx:if="{{scanning}}" class="scanning">
        <view class="spinner"></view>
        <text class="sub">{{scanHint}}</text>
      </view>

      <view wx:if="{{scanning}}" class="btn btn-ghost crop-btn" bindtap="cancelScan">取消识别，返回重拍</view>

      <view wx:if="{{errorMsg}}" class="notice">
        <text class="notice-text">{{errorMsg}}</text>
        <text class="notice-help" bindtap="goHelp">还是不行？告诉我们 ›</text>
      </view>

      <view class="btn btn-primary shoot-btn" bindtap="chooseImage">拍照 / 从相册选</view>
    </view>
  </block>

  <!-- 第二步：框出要学的那一段 -->
  <block wx:elif="{{step === 'crop'}}">
    <view class="card">
      <view class="row-between">
        <text class="title">框出要学的那一段</text>
        <text class="chip chip-stone" bindtap="chooseImage">重拍</text>
      </view>
      <text class="muted picker-note">拖动选框或拽四个角调整范围，只识别框里的字，桌上的其他东西就不会混进来。</text>

      <view
        class="crop-stage"
        style="height:{{stageH}}px"
        bindtouchstart="onCropTouchStart"
        bindtouchmove="onCropTouchMove"
        bindtouchend="onCropTouchEnd"
        bindtouchcancel="onCropTouchEnd"
      >
        <image src="{{imagePath}}" class="crop-img" mode="aspectFit" />

        <view
          wx:if="{{rectPx}}"
          class="crop-sel"
          style="left:{{rectPx.left}}px;top:{{rectPx.top}}px;width:{{rectPx.width}}px;height:{{rectPx.height}}px"
        >
          <view class="grip grip-nw"><view class="grip-dot"></view></view>
          <view class="grip grip-ne"><view class="grip-dot"></view></view>
          <view class="grip grip-sw"><view class="grip-dot"></view></view>
          <view class="grip grip-se"><view class="grip-dot"></view></view>
        </view>

        <view wx:if="{{scanning || cropping}}" class="crop-busy">
          <view class="spinner"></view>
          <text class="crop-busy-text">{{scanHint}}</text>
        </view>
      </view>

      <view class="btn btn-primary crop-btn" bindtap="cropAndScan">
        {{cropping ? '正在裁剪…' : '就识别这里'}}
      </view>
      <view class="btn btn-ghost crop-btn" bindtap="useWholePage">整页识别</view>
      <view wx:if="{{scanning}}" class="btn btn-ghost crop-btn" bindtap="cancelScan">取消识别，返回重拍</view>
    </view>
  </block>

  <!-- 第三步：校对识别结果 -->
  <block wx:else>
    <view class="card">
      <view class="row result-head">
        <image src="{{imagePath}}" class="thumb" mode="aspectFill" />
        <view class="result-meta">
          <text class="title">{{result.title || '未识别到标题'}}</text>
          <text class="muted">共识别 {{chars.length}} 个核心汉字</text>
        </view>
        <text class="chip chip-stone" bindtap="reset">重新拍</text>
      </view>

      <view wx:if="{{result.rawText}}" class="rawtext">
        <text class="rawtext-label">识别原文</text>
        <text class="rawtext-body">{{result.rawText}}</text>
      </view>
    </view>

    <view class="card">
      <view class="row-between">
        <text class="title">勾选要收入的生字</text>
        <view class="row">
          <text class="link" bindtap="selectAll">全选</text>
          <text class="link link-gap" bindtap="deselectAll">全不选</text>
        </view>
      </view>

      <view
        wx:for="{{chars}}"
        wx:key="char"
        class="char-row {{item.checked ? 'checked' : ''}}"
        data-index="{{index}}"
        bindtap="toggleChar"
      >
        <view class="char-box kai">{{item.char}}</view>
        <view class="char-info">
          <view class="row">
            <text class="char-pinyin">{{item.pinyin || '暂无拼音'}}</text>
            <text wx:if="{{item.isUncertain}}" class="chip chip-amber">识别不确定</text>
          </view>
          <text class="char-meaning">{{item.meaning}}</text>
          <text class="char-words" wx:if="{{item.wordsText}}">组词：{{item.wordsText}}</text>
        </view>
        <view class="check {{item.checked ? 'check-on' : ''}}">✓</view>
      </view>

      <view class="manual">
        <text class="muted">AI 漏掉的字可以手动补：</text>
        <view class="row manual-row">
          <input
            class="manual-input"
            value="{{manualChar}}"
            placeholder="输入汉字，如“雀”"
            maxlength="1"
            bindinput="onManualInput"
          />
          <view class="btn btn-ghost manual-btn" bindtap="addManualChar">
            {{addingManual ? '查询中…' : '补充'}}
          </view>
        </view>
      </view>
    </view>

    <!--
      出处在这一步之前只能回到第一步改：而真正把它写进每个字档案的是下面这个按钮。
      所以在这里把将要记录的值摆出来，并且允许当场改 —— 改完立刻生效（入库读的就是当前值）。
    -->
    <view class="card">
      <view class="row-between source-row">
        <text class="title">生字出处</text>
        <picker
          mode="selector"
          range="{{sources}}"
          value="{{sourceIndex}}"
          bindchange="onSourceChange"
        >
          <view class="picker">
            <text>{{sources[sourceIndex]}}</text>
            <text class="picker-arrow">▾</text>
          </view>
        </picker>
      </view>
      <text class="muted picker-note">
        这 {{selectedCount}} 个字将标记为「{{sources[sourceIndex]}}」，记进各自的字卡档案。
      </text>
    </view>

    <view wx:if="{{errorMsg}}" class="notice notice-standalone">
      <text class="notice-text">{{errorMsg}}</text>
      <text class="notice-help" bindtap="goHelp">还是不行？告诉我们 ›</text>
    </view>

    <view class="btn btn-primary add-btn" bindtap="addToBank">
      收入字库（{{selectedCount}}）
    </view>
  </block>
</view>

<!-- 裁剪用的离屏画布：只做像素处理，不参与布局 -->
<canvas type="2d" id="cropCanvas" class="crop-canvas" />

<tabbar current="ocr" />
