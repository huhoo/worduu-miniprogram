/* ---------- 头部 ---------- */
.head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.head-left {
  flex: 1;
  min-width: 0;
}

.badge {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 700;
  color: #065F46;
  background: var(--green-light);
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

.title {
  display: block;
  font-size: 38rpx;
  font-weight: 900;
  color: var(--ink);
  margin-top: 8rpx;
}

.mode-btn {
  flex-shrink: 0;
  background: var(--green-light);
  color: #047857;
  font-size: 22rpx;
  font-weight: 700;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  margin-left: 16rpx;
}

/* ---------- 阅读卡 ---------- */
.paper {
  background: #FFFFFF;
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  padding: 32rpx 28rpx;
}

.sentence {
  font-family: 'Kaiti SC', 'KaiTi', 'STKaiti', '楷体', serif;
  font-size: 40rpx;
  line-height: 2;
  color: var(--ink);
  padding: 12rpx 16rpx;
  border-radius: 20rpx;
  border-left: 6rpx solid transparent;
  letter-spacing: 2rpx;
}

.sentence-on {
  background: var(--green-light);
  border-left-color: var(--green);
}

.ch {
  display: inline;
}

.ch-punct {
  color: var(--ink-2);
}

.ch-vocab {
  color: #065F46;
  font-weight: 700;
  background: #D1FAE5;
  border-bottom: 4rpx solid #6EE7B7;
}

.ch-plain {
  color: var(--ink);
}

.tip {
  display: flex;
  align-items: flex-start;
  background: var(--page);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 18rpx 20rpx;
  margin-top: 24rpx;
}

.tip-emoji {
  font-size: 24rpx;
  margin-right: 12rpx;
}

.tip-text {
  flex: 1;
  font-size: 21rpx;
  color: var(--ink-2);
  line-height: 1.6;
}

/* ---------- 播放器 ---------- */
.player {
  background: #FFFFFF;
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  padding: 28rpx;
  margin-top: 24rpx;
}

.player-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.counter {
  display: flex;
  align-items: center;
}

.counter-now {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink);
}

.counter-sep {
  font-size: 22rpx;
  color: var(--line);
  margin: 0 8rpx;
}

.counter-all {
  font-size: 22rpx;
  color: var(--ink-3);
}

.rates {
  display: flex;
  background: #F5F5F4;
  border-radius: 16rpx;
  padding: 4rpx;
}

.rate {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--ink-3);
  padding: 8rpx 18rpx;
  border-radius: 12rpx;
}

.rate-on {
  background: #FFFFFF;
  color: #065F46;
  font-weight: 800;
}

.progress {
  height: 8rpx;
  background: #F5F5F4;
  border-radius: 999rpx;
  overflow: hidden;
  margin: 20rpx 0;
}

.progress-bar {
  height: 100%;
  background: var(--green);
  border-radius: 999rpx;
}

.controls {
  display: flex;
  align-items: center;
}

.ctrl {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  border: 1rpx solid var(--line);
  color: var(--ink-2);
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ctrl-on {
  border-color: #6EE7B7;
  background: var(--green-light);
  color: #047857;
}

.play {
  flex: 1;
  margin: 0 20rpx;
  background: var(--green);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 800;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 24rpx;
}

.play-on {
  background: var(--amber);
}

.play-off {
  background: #D6D3D1;
}

.notice {
  display: block;
  margin-top: 20rpx;
  font-size: 21rpx;
  color: #92400E;
  background: var(--amber-light);
  border: 1rpx solid #FDE68A;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  line-height: 1.6;
}

/* ---------- 设置弹层 ---------- */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(28, 25, 23, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  z-index: 50;
}

.sheet {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 32rpx;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink);
}

.sheet-close {
  font-size: 32rpx;
  color: var(--ink-3);
  padding: 4rpx 8rpx;
}

.sheet-label {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--ink-2);
  margin-bottom: 16rpx;
}

.modes {
  display: flex;
}

.mode-item {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink-2);
  padding: 18rpx 0;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  margin-right: 12rpx;
}

.mode-item:last-child {
  margin-right: 0;
}

.mode-item-on {
  border-color: var(--green);
  background: var(--green-light);
  color: #065F46;
  font-weight: 800;
}

.sheet-hint {
  display: block;
  font-size: 21rpx;
  color: var(--ink-3);
  line-height: 1.6;
  margin-top: 16rpx;
}

.apply {
  margin-top: 28rpx;
  background: var(--green);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 800;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 24rpx;
}

.empty {
  text-align: center;
  color: var(--ink-3);
  font-size: 26rpx;
  padding: 120rpx 0;
}
