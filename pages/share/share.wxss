/* 奖状部分与成就卡页同一套视觉，这里复制一份，避免跨页样式依赖 */
.page {
  padding-bottom: 80rpx;
}

/* ---------- 状态 ---------- */
.state {
  padding: 160rpx 0;
  text-align: center;
}

.state-emoji {
  font-size: 64rpx;
}

.state-text {
  display: block;
  font-size: 26rpx;
  color: var(--ink-3);
  margin-top: 20rpx;
}

.invalid {
  background: #FEF2F2;
  border: 1rpx solid #FECACA;
  border-radius: 32rpx;
  padding: 48rpx 32rpx;
  text-align: center;
}

.invalid-emoji {
  font-size: 64rpx;
}

.invalid-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #991B1B;
  margin-top: 16rpx;
}

.invalid-text {
  display: block;
  font-size: 23rpx;
  color: #B91C1C;
  line-height: 1.7;
  margin: 16rpx 0 32rpx;
}

/* ---------- 横幅 ---------- */
.banner {
  background: linear-gradient(135deg, #047857, #0F766E);
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.banner-left {
  display: flex;
  align-items: center;
}

.logo {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.banner-text {
  margin-left: 20rpx;
}

.banner-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.banner-sub {
  font-size: 24rpx;
  color: rgba(236, 253, 245, 0.9);
  margin-top: 4rpx;
}

.strong {
  font-weight: 900;
  color: #FFFFFF;
}

/* ---------- 奖状 ---------- */
.cert {
  background: linear-gradient(180deg, #FFFDF9, #FAF6F0 55%, #F5EFE6);
  border: 3rpx solid #E9DFD0;
  border-radius: 32rpx;
  padding: 32rpx;
}

.cert-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.cert-brand-name {
  display: block;
  font-size: 26rpx;
  font-weight: 900;
  color: var(--ink);
}

.cert-date {
  display: block;
  font-size: 24rpx;
  color: var(--ink-3);
  margin-top: 2rpx;
}

.cert-name {
  background: #D1FAE5;
  color: #065F46;
  font-size: 22rpx;
  font-weight: 800;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
}

.cert-main {
  text-align: center;
  padding: 28rpx 0;
}

.cert-title {
  display: inline-block;
  background: rgba(245, 158, 11, 0.18);
  color: #92400E;
  font-size: 24rpx;
  font-weight: 900;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
}

.cert-score {
  display: block;
  font-size: 56rpx;
  font-weight: 900;
  color: var(--ink);
  margin-top: 20rpx;
  font-family: 'Kaiti SC', 'KaiTi', 'STKaiti', '楷体', serif;
}

.cert-praise {
  display: block;
  font-size: 23rpx;
  color: var(--ink-2);
  font-style: italic;
  margin-top: 12rpx;
}

.metrics {
  display: flex;
}

.metric {
  flex: 1;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(231, 229, 228, 0.9);
  border-radius: 24rpx;
  padding: 18rpx 8rpx;
  text-align: center;
  margin-right: 12rpx;
}

.metric:last-child {
  margin-right: 0;
}

.metric-label {
  font-size: 22rpx;
  color: var(--ink-3);
}

.metric-value {
  font-size: 34rpx;
  font-weight: 900;
  color: var(--ink);
  margin-top: 6rpx;
}

.metric-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--ink-3);
  margin-left: 2rpx;
}

.chars {
  margin-top: 28rpx;
  text-align: center;
}

.chars-label {
  font-size: 22rpx;
  font-weight: 800;
  color: var(--ink-3);
}

.chips {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  margin-top: 16rpx;
}

.chip {
  background: #FFFFFF;
  border: 1rpx solid #E9DFD0;
  border-radius: 20rpx;
  padding: 12rpx 20rpx;
  margin: 8rpx;
  display: flex;
  align-items: baseline;
  min-height: 88rpx;
}

.chip-char {
  font-size: 40rpx;
  font-weight: 900;
  color: var(--ink);
  font-family: 'Kaiti SC', 'KaiTi', 'STKaiti', '楷体', serif;
}

.chip-pinyin {
  font-size: 24rpx;
  color: var(--ink-3);
  margin-left: 10rpx;
}

/* ---------- 点赞 ---------- */
.like-box {
  background: #FFFFFF;
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  padding: 28rpx;
  margin-top: 24rpx;
}

.like-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F5F5F4;
}

.like-head-left {
  flex: 1;
  min-width: 0;
}

.like-title {
  display: block;
  font-size: 27rpx;
  font-weight: 800;
  color: var(--ink);
}

.like-sub {
  display: block;
  font-size: 24rpx;
  color: var(--ink-3);
  margin-top: 4rpx;
  line-height: 1.6;
}

.like-count {
  flex-shrink: 0;
  background: #FFF1F2;
  color: #BE123C;
  font-size: 24rpx;
  font-weight: 800;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  margin-left: 16rpx;
}

.step {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink-2);
  margin: 24rpx 0 14rpx;
}

.roles {
  display: flex;
  flex-wrap: wrap;
}

.role {
  width: 31%;
  margin-right: 3.5%;
  margin-bottom: 14rpx;
  background: #FAFAF9;
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  padding: 16rpx 10rpx;
  display: flex;
  align-items: center;
  min-height: 88rpx;
}

.role:nth-child(3n) {
  margin-right: 0;
}

.role-on {
  background: #FFF1F2;
  border-color: #FDA4AF;
}

.role-emoji {
  font-size: 26rpx;
  margin-right: 8rpx;
}

.role-name {
  font-size: 24rpx;
  color: var(--ink-2);
  font-weight: 600;
}

.role-on .role-name {
  color: #9F1239;
}

.input {
  width: 100%;
  box-sizing: border-box;
  background: #FAFAF9;
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  padding: 20rpx;
  font-size: 24rpx;
  color: var(--ink);
}

.btn {
  width: 100%;
  font-size: 27rpx;
  font-weight: 800;
  text-align: center;
  padding: 26rpx 0;
  border-radius: 24rpx;
  margin-top: 24rpx;
  line-height: 1.4;
  min-height: 88rpx;
}

.btn-primary {
  background: var(--green);
  color: #FFFFFF;
  min-height: 88rpx;
}

.btn-like {
  background: linear-gradient(90deg, #F43F5E, #EC4899);
  color: #FFFFFF;
}

.btn-done {
  background: var(--green);
  color: #FFFFFF;
}

.btn-off {
  background: #E7E5E4;
  color: #A8A29E;
}

.btn-inline {
  display: inline-block;
  width: auto;
  padding: 20rpx 48rpx;
  min-height: 88rpx;
}

.sync-fail {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #92400E;
  background: var(--amber-light);
  border: 1rpx solid #FDE68A;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  line-height: 1.6;
}

/* ---------- 点赞墙 ---------- */
.wall {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F5F5F4;
}

.wall-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink-2);
}

.wall-list {
  margin-top: 16rpx;
}

.wall-item {
  display: flex;
  align-items: flex-start;
  background: #FAFAF9;
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}

.wall-emoji {
  font-size: 26rpx;
  margin-right: 14rpx;
}

.wall-body {
  flex: 1;
  min-width: 0;
}

.wall-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.wall-name {
  font-size: 22rpx;
  font-weight: 800;
  color: var(--ink);
}

.wall-time {
  font-size: 22rpx;
  color: var(--ink-3);
}

.wall-msg {
  display: block;
  font-size: 24rpx;
  color: var(--ink-2);
  margin-top: 4rpx;
  line-height: 1.6;
}

.wall-empty {
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-3);
  background: #FAFAF9;
  border-radius: 18rpx;
  padding: 28rpx;
  margin-top: 16rpx;
}

/* ---------- 引流 ---------- */
.promo {
  background: var(--green-light);
  border: 1rpx solid #A7F3D0;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-top: 24rpx;
  text-align: center;
}

.promo-title {
  display: block;
  font-size: 25rpx;
  font-weight: 800;
  color: #065F46;
}

.promo-text {
  display: block;
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.7;
  margin-top: 12rpx;
}
