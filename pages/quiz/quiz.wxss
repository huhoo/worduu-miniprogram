/* ---------- 顶部进度条 ---------- */
.bar {
  background: #FFFFFF;
  border: 1rpx solid #E7E5E4;
  border-radius: 24rpx;
  padding: 18rpx 28rpx;
}

.bar-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #57534E;
}

.bar-progress {
  font-size: 24rpx;
  font-weight: 700;
  font-family: 'SF Mono', Menlo, monospace;
  color: #065F46;
  background: #ECFDF5;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
}

/* ---------- 大字卡 ---------- */
.stage {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.big-box {
  position: relative;
  width: 380rpx;
  height: 380rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stage-char {
  position: relative;
  font-size: 220rpx;
  font-weight: 800;
  color: #1C1917;
  line-height: 1;
}

.pinyin-row {
  margin-top: 28rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
}

.stage-pinyin {
  font-size: 56rpx;
  font-weight: 700;
  font-family: 'SF Mono', Menlo, monospace;
  letter-spacing: 4rpx;
}

.pinyin-link {
  font-size: 24rpx;
  color: #A8A29E;
  text-decoration: underline;
  min-height: 88rpx;
}

.audio-row {
  margin-top: 16rpx;
  width: 100%;
}

.audio-btn {
  flex: 1;
  min-height: 88rpx;
}

.audio-row .audio-btn:first-child {
  margin-right: 16rpx;
}

.source {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #A8A29E;
  background: #FAFAF9;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
}

/* ---------- 作答区 ---------- */
.ask {
  display: block;
  text-align: center;
}

.ask-note {
  display: block;
  margin-top: 16rpx;
  line-height: 1.7;
}

.judge-row {
  margin-top: 28rpx;
}

.judge-btn {
  flex: 1;
  min-height: 88rpx;
}

.judge-row .judge-btn:first-child {
  margin-right: 16rpx;
}

/* ---------- 结果 ---------- */
.result {
  margin-top: 24rpx;
  border-radius: 28rpx;
}

.result-ok {
  background: #ECFDF5;
  border-color: #A7F3D0;
}

.result-bad {
  background: #FFFBEB;
  border-color: #FDE68A;
}

.result-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.result-title {
  font-size: 30rpx;
  font-weight: 700;
}

.result-time {
  font-size: 24rpx;
  font-weight: 700;
  font-family: 'SF Mono', Menlo, monospace;
  background: rgba(255, 255, 255, 0.8);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.result-feedback {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
}

.next-btn {
  margin-top: 32rpx;
  width: 100%;
  min-height: 88rpx;
}

/* ---------- 报告 ---------- */
.report {
  text-align: center;
  padding: 48rpx 28rpx;
}

.report-percent {
  font-size: 80rpx;
  font-weight: 800;
  font-family: 'SF Mono', Menlo, monospace;
  color: #059669;
}

.report-line {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #1C1917;
}

.warn-icon {
  font-size: 30rpx;
  margin-right: 10rpx;
}

.wrong-grid {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
}

.wrong-item {
  width: calc(25% - 12rpx);
  margin: 0 8rpx 16rpx;
  background: #FFF1F2;
  border: 1rpx solid #FECDD3;
  border-radius: 20rpx;
  padding: 16rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 88rpx;
}

.wrong-char {
  font-size: 48rpx;
  font-weight: 800;
  color: #9F1239;
}

.wrong-pinyin {
  font-size: 22rpx;
  color: #BE123C;
  font-family: 'SF Mono', Menlo, monospace;
}

.perfect {
  text-align: center;
  padding: 48rpx 28rpx;
}

.perfect-icon {
  font-size: 72rpx;
}

.empty-btn {
  margin-top: 28rpx;
  width: 60%;
  min-height: 88rpx;
}
