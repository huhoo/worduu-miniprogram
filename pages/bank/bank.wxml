<view class="page">
  <!-- 搜索 -->
  <view class="search">
    <text class="search-icon">🔍</text>
    <input
      class="search-input"
      value="{{keyword}}"
      placeholder="搜索汉字、拼音或组词（如：蝶、xuě、森林）"
      bindinput="onSearch"
    />
  </view>

  <!-- 待巩固默写库：生字库页顶部常驻卡片（PRD 9.5） -->
  <view class="card pool-card" bindtap="goPool">
    <view class="pool-body">
      <view class="row-t">待巩固默写库 <text class="pool-count">{{poolCount}} 字</text></view>
      <view class="row-s" wx:if="{{poolCount > 0}}">
        <block wx:if="{{poolOldest}}">最久未过：{{poolOldest.char}}（{{poolOldest.days}} 天）· 连续写对 2 次自动出库</block>
        <block wx:else>{{poolCount}} 个字等待巩固 · 连续写对 2 次自动出库</block>
      </view>
      <view class="row-s pool-clear" wx:else>全部字都过关啦，保持住 🎉</view>
    </view>
    <text class="entry-go">›</text>
  </view>

  <!-- 学习足迹入口（PRD 8.3） -->
  <view class="card entry-row" bindtap="goFootprint">
    <text class="entry-ic">🗓️</text>
    <view class="entry-body">
      <view class="row-t">学习足迹</view>
      <view class="row-s">按天的生字账本<block wx:if="{{footprintDays > 0}}"> · 已有 {{footprintDays}} 天</block> · 可圈日期范围去默写</view>
    </view>
    <text class="entry-go">›</text>
  </view>

  <!-- 分类 -->
  <scroll-view scroll-x class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab {{activeTab === item.key ? 'tab-on' : ''}}"
      data-key="{{item.key}}"
      bindtap="onTabTap"
    >{{item.key}} ({{item.count}})</view>
  </scroll-view>

  <!-- 列表 -->
  <view class="card list-card">
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="item"
      data-id="{{item.id}}"
      bindtap="openDetail"
    >
      <view class="item-char kai">{{item.char}}</view>
      <view class="item-body">
        <view class="row">
          <text class="item-pinyin">{{item.pinyin || '暂无拼音'}}</text>
          <text class="chip chip-plain">{{item.source}}</text>
        </view>
        <text class="item-date">{{item.dateEncounteredText}} 遇到</text>
        <text class="item-words" wx:if="{{item.wordsText}}">组词：{{item.wordsText}}</text>
      </view>
      <view class="item-right">
        <text class="mastery mastery-{{item.masteryClass}}">{{item.mastery}}</text>
        <view class="row item-actions">
          <view class="play" data-id="{{item.id}}" catchtap="playChar">🔊</view>
          <!-- 练写直达：原来只能先进字卡再跳书写，多绕一步 -->
          <view class="play" data-char="{{item.char}}" catchtap="goWrite">✍️</view>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{list.length === 0}}">
      <view class="empty-icon">🔍</view>
      <text class="sub" wx:if="{{total > 0}}">没有找到匹配的汉字</text>
      <block wx:else>
        <text class="sub">字库还是空的</text>
        <text class="muted">拍一页课本或课外书，生字会自动收进来</text>
        <view class="btn btn-primary empty-btn" bindtap="goOcr">去拍照识字</view>
      </block>
    </view>
  </view>

  <view wx:if="{{total > 0}}" class="btn btn-primary quiz-btn" bindtap="goQuiz">
    开始认读测试（{{total}} 字）
  </view>
</view>

<!-- 二级页：底栏保留（回主页走底栏），但不高亮任何 tab -->
<tabbar current="" />
