/* ---------- 搜索 ---------- */
.search {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 1rpx solid #E7E5E4;
  border-radius: 24rpx;
  padding: 18rpx 24rpx;
  box-shadow: 0 1rpx 3rpx rgba(28, 25, 23, 0.04);
}

.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
}

/* ---------- 分类标签 ---------- */
.tabs {
  margin-top: 24rpx;
  white-space: nowrap;
}

.tab {
  display: inline-block;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #57534E;
  background: #FFFFFF;
  border: 1rpx solid #E7E5E4;
  margin-right: 16rpx;
  min-height: 88rpx;
}

.tab-on {
  background: #059669;
  color: #FFFFFF;
  border-color: #059669;
}

/* ---------- 列表 ---------- */
.list-card {
  margin-top: 24rpx;
  padding: 8rpx 28rpx;
}

.item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F5F4;
  min-height: 88rpx;
}

.item:last-child {
  border-bottom: none;
}

.item:active {
  background: #FAFAF9;
}

.item-char {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  background: #FCFAF7;
  border: 1rpx solid #E26D5C;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.item-body {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}

.item-pinyin {
  font-size: 26rpx;
  font-weight: 700;
  font-family: 'SF Mono', Menlo, monospace;
}

.item-date {
  display: block;
  font-size: 24rpx;
  color: #A8A29E;
  margin-top: 4rpx;
}

.item-words {
  display: block;
  font-size: 22rpx;
  color: #78716C;
  margin-top: 6rpx;
}

.item-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.mastery {
  font-size: 24rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid transparent;
}

.mastery-green {
  background: #ECFDF5;
  color: #065F46;
  border-color: #A7F3D0;
}

.mastery-blue {
  background: #EFF6FF;
  color: #1E40AF;
  border-color: #BFDBFE;
}

.mastery-amber {
  background: #FFFBEB;
  color: #92400E;
  border-color: #FDE68A;
}

.mastery-rose {
  background: #FFF1F2;
  color: #9F1239;
  border-color: #FECDD3;
}

.play {
  margin-top: 12rpx;
  font-size: 32rpx;
  opacity: 0.6;
  padding: 4rpx;
  min-height: 88rpx;
}

.empty-btn {
  margin-top: 28rpx;
  min-height: 88rpx;
}

.quiz-btn {
  margin-top: 32rpx;
  width: 100%;
}
