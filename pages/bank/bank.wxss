/* ---------- 搜索 ---------- */
.search {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 18rpx 24rpx;
  box-shadow: 0 1rpx 3rpx rgba(43, 58, 48, 0.04);
}

.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
}

/* ---------- 分类标签 ---------- */
.tabs {
  margin-top: 24rpx;
  white-space: nowrap;
}

.tab {
  display: inline-block;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--ink-2);
  background: #FFFFFF;
  border: 1rpx solid var(--line);
  margin-right: 16rpx;
  min-height: 88rpx;
}

.tab-on {
  background: var(--green);
  color: #FFFFFF;
  border-color: var(--green);
}

/* ---------- 列表 ---------- */
.list-card {
  margin-top: 24rpx;
  padding: 8rpx 28rpx;
}

.item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #DCE8D9;
  min-height: 88rpx;
}

.item:last-child {
  border-bottom: none;
}

.item:active {
  background: #F5FAF3;
}

.item-char {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  background: var(--app-surface);
  border: 1rpx solid var(--vermilion);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.item-body {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}

.item-pinyin {
  font-size: 26rpx;
  font-weight: 700;
  font-family: 'SF Mono', Menlo, monospace;
  color: var(--indigo);
}

.item-date {
  display: block;
  font-size: 24rpx;
  color: var(--ink-3);
  margin-top: 4rpx;
}

.item-words {
  display: block;
  font-size: 22rpx;
  color: #57685B;
  margin-top: 6rpx;
}

.item-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.mastery {
  font-size: 24rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid transparent;
}

.mastery-green {
  background: var(--green-light);
  color: var(--indigo);
  border-color: var(--line-2);
}

.mastery-blue {
  background: #EFF6FF;
  color: #1E40AF;
  border-color: #BFDBFE;
}

.mastery-amber {
  background: var(--amber-light);
  color: var(--amber-ink);
  border-color: var(--amber-line);
}

.mastery-rose {
  background: #FFF1F2;
  color: #9F1239;
  border-color: #FECDD3;
}

.play {
  margin-top: 12rpx;
  font-size: 32rpx;
  opacity: 0.6;
  padding: 4rpx;
  min-height: 88rpx;
}

.empty-btn {
  margin-top: 28rpx;
  min-height: 88rpx;
}

.quiz-btn {
  margin-top: 32rpx;
  width: 100%;
}

/* ---------- 卡片操作：读音 + 练写并排 ---------- */
.item-actions {
  margin-top: 12rpx;
}

.item-actions .play {
  margin-top: 0;
}
