/* ---------- 顶部横幅 ---------- */
.banner {
  position: relative;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #10B981 0%, #059669 55%, #0F766E 100%);
  color: #FFFFFF;
  padding: 40rpx 32rpx 32rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(5, 150, 105, 0.18);
}

.banner-body {
  position: relative;
  z-index: 2;
}

.banner-tag {
  display: inline-flex;
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.banner-tag-text {
  font-size: 24rpx;
  font-weight: 600;
}

.banner-title {
  margin-top: 16rpx;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.35;
  white-space: pre-wrap;
}

.banner-sub {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: rgba(236, 253, 245, 0.95);
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FCD34D;
  margin-right: 12rpx;
}

.banner-mascot {
  position: absolute;
  right: 24rpx;
  top: 32rpx;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 28rpx;
  padding: 12rpx 16rpx;
}

.mascot-emoji {
  font-size: 56rpx;
}

.mascot-label {
  font-size: 22rpx;
  font-weight: 700;
  margin-top: 4rpx;
}

/* ---------- 模块宫格 ---------- */
.grid {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.module {
  width: calc(50% - 12rpx);
  background: #FFFFFF;
  border: 1rpx solid #E7E5E4;
  border-radius: 36rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 1rpx 3rpx rgba(28, 25, 23, 0.04);
  min-height: 88rpx;
}

.module:active {
  background: #FAFAF9;
}

/* 奇数个模块时最后一格占满整行，免得底部留半行空白 */
.module:last-child:nth-child(odd) {
  width: 100%;
}

.module-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.module-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.module-badge {
  font-size: 22rpx;
  color: #A8A29E;
  background: #F5F5F4;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

.module-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1C1917;
}

.module-sub {
  font-size: 22rpx;
  color: #78716C;
  margin-top: 8rpx;
  line-height: 1.5;
}

/* ---------- 今日进展 ---------- */
.progress-head {
  margin-bottom: 20rpx;
}

.flame {
  font-size: 30rpx;
  margin-right: 10rpx;
}

.more {
  font-size: 22rpx;
  color: #059669;
  font-weight: 600;
  min-height: 88rpx;
}

.progress-grid {
  display: flex;
  background: #FAFAF9;
  border-radius: 28rpx;
  padding: 20rpx 0;
}

.progress-cell {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #E7E5E4;
}

.progress-cell:last-child {
  border-right: none;
}

.progress-num {
  font-size: 44rpx;
  font-weight: 800;
  font-family: 'SF Mono', Menlo, monospace;
}

.progress-num.green {
  color: #059669;
}

.progress-num.amber {
  color: #D97706;
}

.progress-label {
  font-size: 24rpx;
  color: #78716C;
  margin-top: 4rpx;
}

/* ---------- 最近生字 ---------- */
.recent-grid {
  margin-top: 24rpx;
  display: flex;
  justify-content: space-between;
}

.recent-item {
  width: calc(25% - 10rpx);
  background: #FCFAF7;
  border: 1rpx solid #E7E5E4;
  border-radius: 24rpx;
  padding: 16rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 88rpx;
}

.recent-item:active {
  background: #ECFDF5;
}

.recent-char {
  font-size: 52rpx;
  font-weight: 800;
  color: #1C1917;
}

.recent-pinyin {
  font-size: 22rpx;
  color: #78716C;
  margin-top: 4rpx;
  font-family: 'SF Mono', Menlo, monospace;
}

.recent-source {
  font-size: 22rpx;
  color: #A8A29E;
  margin-top: 6rpx;
}

.empty-btn {
  margin-top: 28rpx;
  display: inline-flex;
  min-height: 88rpx;
}
