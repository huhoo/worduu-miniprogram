/* ===== 首页 Hub（R1，照原型 home-reading：品牌头 + 四大入口 + 阅读行）===== */

/* ---------- 品牌头 ---------- */
.home-head {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0 8rpx;
}

.hh-name {
  font-size: 47rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  color: var(--green);
  line-height: 1.1;
}

.hh-slogan {
  font-size: 22rpx;
  color: var(--ink-2);
  margin-top: 10rpx;
}

.hh-url {
  font-size: 19rpx;
  color: var(--ink-3);
  margin-top: 6rpx;
  letter-spacing: 4rpx;
}

.hh-acts {
  margin-left: auto;
  display: flex;
  gap: 16rpx;
}

.icon-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: var(--app-surface);
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--ink-2);
}

.icon-btn:active {
  background: var(--app-surface-2);
}

.icon-btn-img {
  width: 34rpx;
  height: 34rpx;
}

/* ---------- 入口卡 ---------- */
.home-entries {
  margin-top: 20rpx;
}

.home-entry {
  display: flex;
  align-items: center;
  gap: 26rpx;
  padding: 32rpx 30rpx;
  border-radius: 30rpx;
  /* 卡片间距由全局 .card + .card 的 24rpx 上边距负责，这里不重复加 */
}

.home-entry:active {
  background: var(--app-surface-2);
}

.he-ic {
  width: 98rpx;
  height: 98rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  font-size: 48rpx;
}

/* 第一个入口同样软绿底 + 绿线图标（设计图规范：全部入口统一浅底绿线图标） */
.he-ic.cam {
  background: #E7F3E9;
}

.he-ic.soft {
  background: #E7F3E9;
}

.he-img {
  width: 52rpx;
  height: 52rpx;
}

.he-main {
  flex: 1;
  min-width: 0;
}

.he-t {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: 2rpx;
}

.he-s {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 8rpx;
  line-height: 1.5;
}

.he-chevron {
  font-size: 34rpx;
  color: var(--ink-3);
  flex: none;
  font-weight: 300;
}

/* ---------- 阅读伴读行卡 ---------- */
.home-row {
  display: flex;
  align-items: center;
  gap: 26rpx;
  margin-top: 28rpx;
  padding: 26rpx 30rpx;
  border-radius: 30rpx;
}

.home-row:active {
  background: var(--app-surface-2);
}

.hr-cov {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: var(--app-surface-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  flex: none;
}

/* 页脚识字档案链接（原右上角齿轮入口移到这里） */
.profile-link {
  text-align: center;
  padding: 20rpx 0 40rpx;
  font-size: 24rpx;
  color: #7A8B7E;
}
