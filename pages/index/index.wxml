<view class="page">
  <!-- 品牌头（原型 home-reading）：字伴 + 口号 + 搜索/设置 -->
  <view class="home-head">
    <view class="hh-brand">
      <view class="hh-name">字伴</view>
      <view class="hh-slogan">让每个汉字都成为伙伴</view>
      <view class="hh-url">WORDUU.COM</view>
    </view>
    <view class="hh-acts">
      <view class="icon-btn" bindtap="openBank">
        <image class="icon-btn-img" src="/images/icons/search-ink.png" mode="aspectFit" />
      </view>
      <view class="icon-btn" bindtap="openProfile">
        <image class="icon-btn-img" src="/images/icons/gear-ink.png" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- 四大入口（原型顺序：拍 / 写 / 库 / 默） -->
  <view class="home-entries">
    <view class="card home-entry" data-key="ocr" bindtap="goModule">
      <view class="he-ic cam">
        <image class="he-img" src="/images/icons/camera-green.png" mode="aspectFit" />
      </view>
      <view class="he-main">
        <view class="he-t">拍照识字</view>
        <view class="he-s">拍课本或课外书，生字自动进字库</view>
      </view>
      <text class="he-chevron">›</text>
    </view>

    <view class="card home-entry" data-key="write" bindtap="goModule">
      <view class="he-ic soft">
        <image class="he-img" src="/images/icons/pencil-green.png" mode="aspectFit" />
      </view>
      <view class="he-main">
        <view class="he-t">写字识字</view>
        <view class="he-s">田字格练写，笔顺动画加 AI 批改</view>
      </view>
      <text class="he-chevron">›</text>
    </view>

    <view class="card home-entry" data-key="bank" bindtap="goModule">
      <view class="he-ic soft">
        <image class="he-img" src="/images/icons/book-green.png" mode="aspectFit" />
      </view>
      <view class="he-main">
        <view class="he-t">生字库</view>
        <view class="he-s">查字、听发音、掌握度一目了然</view>
      </view>
      <text class="he-chevron">›</text>
    </view>

    <view class="card home-entry" data-key="dictation" bindtap="goModule">
      <view class="he-ic soft">
        <image class="he-img" src="/images/icons/doc-green.png" mode="aspectFit" />
      </view>
      <view class="he-main">
        <view class="he-t">默写</view>
        <view class="he-s">AI 报字听写，自动批改巩固</view>
      </view>
      <text class="he-chevron">›</text>
    </view>
  </view>

  <!-- 阅读伴读（现有能力：书架内置读物。
       没有真实阅读进度数据，不放假进度条——原型此槽位是「继续阅读」，
       等 R6 拍照阅读上线后再换回真进度） -->
  <view class="card home-row" data-key="shelf" bindtap="goModule">
    <view class="hr-cov">
      <image class="he-img" src="/images/icons/book-green.png" mode="aspectFit" />
    </view>
    <view class="he-main">
      <view class="he-t">阅读伴读</view>
      <view class="he-s">内置读物逐句朗读，点字查义</view>
    </view>
    <text class="he-chevron">›</text>
  </view>
</view>

<tabbar current="index" />
