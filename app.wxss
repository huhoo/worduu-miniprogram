/**
 * 全局样式 · 白 + 护眼绿（R1 换色，规范见 ziban-prd/BASELINE.md 第 4 节）
 * 页面底 #F5FAF3 / 卡片 #FFFFFF / 次级面 #ECF4E9 / 主绿 #3F8E5D / 辅绿 #6DB589
 */
/* 统一盒模型：padding/border 计入 width，避免 calc 百分比栅格溢出换行 */
view,
text,
image,
button,
input,
textarea,
canvas {
  box-sizing: border-box;
}

page {
  /* 基准色板（BASELINE.md 命名）＋ 旧名别名，各页可逐步迁移到基准名 */
  --app-bg: #F5FAF3;
  --page: #F5FAF3;
  --app-surface: #FFFFFF;
  --app-surface-2: #ECF4E9;
  --paper: #FFFFFF;
  --ink: #2B3A30;
  --ink-2: #57685B;
  --ink-3: #93A397;
  --line: #DCE8D9;
  --line-2: #C0D3BD;
  --green: #3F8E5D;
  --green-2: #6DB589;
  --green-light: #E9F4E5;
  --indigo: #2F6B50;
  --moss: #5FA778;
  /* 田字格：原朱红位改为绿系（边框辅绿、虚线浅绿） */
  --vermilion: #6DB589;
  --vermilion-light: #BFE3C9;
  /* 语义点缀：复习提醒 / 限时 / 繁体标签（BASELINE：gold / amber） */
  --amber: #B8862E;
  --amber-light: #F6EEDD;
  --amber-ink: #8C6D1F;
  --amber-line: #E9D8AC;
  --gold: #A8913F;

  background: var(--page);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/** 楷体：汉字展示专用 */
.kai {
  font-family: 'Kaiti SC', 'KaiTi', 'STKaiti', '楷体', 'Songti SC', 'SimSun', serif;
}

/* ---------- 容器 ---------- */
.page {
  padding: 24rpx 24rpx 160rpx;
}

.card {
  background: #FFFFFF;
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  padding: 28rpx;
  box-shadow: 0 1rpx 3rpx rgba(28, 25, 23, 0.04);
}

.card + .card {
  margin-top: 24rpx;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* ---------- 文字 ---------- */
.title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}

.sub {
  font-size: 24rpx;
  color: var(--ink-2);
}

.muted {
  font-size: 22rpx;
  color: var(--ink-3);
}

.mono {
  font-family: 'SF Mono', 'Menlo', monospace;
}

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  transition: opacity 0.15s;
  min-height: 88rpx;
}

.btn-primary {
  background: var(--green);
  color: #FFFFFF;
  padding: 24rpx 32rpx;
  min-height: 88rpx;
}

.btn-ghost {
  background: #FFFFFF;
  color: var(--ink-2);
  border: 1rpx solid var(--line);
  padding: 20rpx 28rpx;
  min-height: 88rpx;
}

.btn:active {
  opacity: 0.75;
}

.btn-disabled {
  opacity: 0.4;
}

/* ---------- 标签 ---------- */
.chip {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
  min-height: 88rpx;
}

.chip-green { background: var(--green-light); color: var(--indigo); }
.chip-amber { background: var(--amber-light); color: var(--amber-ink); }
.chip-rose  { background: #FFF1F2; color: #9F1239; }
.chip-blue  { background: #EFF6FF; color: #1E40AF; }
.chip-stone { background: #F5F5F4; color: var(--ink-2);
  min-height: 88rpx;
}

/* ---------- 田字格 ---------- */
.tianzige {
  position: relative;
  background: var(--paper);
  border: 4rpx solid var(--vermilion);
  border-radius: 32rpx;
  overflow: hidden;
}

.tianzige-guide {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  pointer-events: none;
}

.guide-line {
  position: absolute;
  background: transparent;
  border-style: dashed;
  border-color: var(--vermilion-light);
}

.guide-v {
  top: 0;
  bottom: 0;
  left: 50%;
  border-left-width: 2rpx;
}

.guide-h {
  left: 0;
  right: 0;
  top: 50%;
  border-top-width: 2rpx;
}

/* ---------- 空状态 ---------- */
.empty {
  padding: 80rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 64rpx;
  opacity: 0.35;
}

/* ---------- 底部导航栏 ---------- */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: #FFFFFF;
  border-top: 1rpx solid var(--line);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}

.tabbar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0 12rpx;
  min-height: 88rpx;
}

.tabbar-emoji {
  font-size: 40rpx;
  line-height: 1.2;
}

.tabbar-label {
  font-size: 24rpx;
  margin-top: 4rpx;
  color: var(--ink-3);
}

.tabbar-item.active .tabbar-label {
  color: var(--green);
  font-weight: 700;
}
